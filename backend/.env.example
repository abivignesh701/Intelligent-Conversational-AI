# ============================================
# Crime Intelligence Platform — Environment Variables Example
# ============================================

# --- Gemini AI (REQUIRED: Ask user to provide) ---
GEMINI_API_KEY=

# --- Model Selection ---
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/crime_intel.db

# --- JWT Security (Generated automatically) ---
JWT_SECRET=f98a72c19e48b2d6a501c38e74f29104b2c893d19e57201c384e6291a0c4921b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Vector Store & Upload Paths ---
VECTOR_DB_PATH=data/vector_store
UPLOAD_DIRECTORY=uploads

# --- Application Configuration ---
APP_NAME=KSP Crime Intelligence Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
LOG_LEVEL=INFO
LOG_FORMAT=json
